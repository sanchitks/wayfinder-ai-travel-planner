# Copy to backend/.env. Every key is optional: anything missing falls back to
# deterministic demo data (or heuristics, for the LLM), so the app always runs.

# --- Core intelligence (pick one) ---------------------------------------------
# Preferred (per PRD): Claude Opus 5.5 through OpenRouter, with model fallback.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-opus-5.5
# Tried in order if the primary model is rate-limited, down or unknown.
OPENROUTER_FALLBACK_MODELS=anthropic/claude-sonnet-5.5

# Alternative: the Claude API directly (used only when OPENROUTER_API_KEY is empty).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Flights: Ignav - live fares in INR (India market) + airline booking links.
# 1,000 free requests, then ~$2 per 1,000. https://ignav.com - see KEYS.md
IGNAV_API_KEY=
IGNAV_MARKET=IN

# --- Flights: Amadeus. The free Self-Service portal shut down on 17 July 2026,
# so leave these blank unless you have an Amadeus Enterprise contract
# (then also set AMADEUS_BASE_URL=https://api.amadeus.com). See KEYS.md.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# --- RapidAPI key, shared by Skyscanner (Sky Scrapper) and Booking.com ---------
RAPIDAPI_KEY=
SKYSCANNER_RAPIDAPI_HOST=sky-scrapper.p.rapidapi.com
BOOKING_RAPIDAPI_HOST=booking-com15.p.rapidapi.com

# --- Experiences & dining -------------------------------------------------------
GOOGLE_PLACES_API_KEY=
YELP_API_KEY=

# --- App --------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Interactive API docs at /docs; set false on a public server
API_DOCS=true
# Refuse new passwords found in data breaches (Have I Been Pwned; only 5 hash characters are sent)
CHECK_BREACHED_PASSWORDS=true
# Localized for India: all prices in rupees.
CURRENCY=INR

# --- Accounts & database ---
# SQLite file by default; for PostgreSQL: postgresql+psycopg://user:pass@host/db
DATABASE_URL=sqlite:///./data/wayfinder.db
# true when served over HTTPS (browsers also allow it on http://localhost)
COOKIE_SECURE=true

# --- Google sign-in (free; see KEYS.md) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
FRONTEND_URL=http://localhost:3000

# --- Admin panel & privacy ---
# Comma-separated emails that can open /admin
ADMIN_EMAILS=
# Shown on /privacy as the contact for privacy questions
PRIVACY_CONTACT_EMAIL=
# Only behind a proxy/load balancer: its IPs or ranges, e.g. 10.0.0.0/8
TRUSTED_PROXIES=
VISIT_RETENTION_DAYS=365
